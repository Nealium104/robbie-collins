---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<form
  id="contact-form"
  class="bg-base-200 border-base-300 rounded-box border p-5 shadow-xl sm:p-8"
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="mb-2 block" for="name">Name</label>
      <input
        id="name"
        type="text"
        name="name"
        maxlength="100"
        autocomplete="name"
        placeholder="Your name"
        class="input input-bordered w-full bg-white text-black"
        required
      />
    </div>

    <div>
      <label class="mb-2 block" for="email">Email</label>
      <input
        id="email"
        type="email"
        name="email"
        maxlength="200"
        autocomplete="email"
        placeholder="you@example.com"
        class="input input-bordered w-full bg-white text-black"
        required
      />
    </div>

    <div class="sm:col-span-2">
      <label class="mb-2 block" for="message">Message</label>
      <textarea
        id="message"
        name="message"
        maxlength="5000"
        placeholder="What would you like to talk about?"
        class="textarea textarea-bordered min-h-36 w-full bg-white text-black"
        required></textarea>
    </div>
  </div>

  <div class="flex justify-center py-4">
    <div
      class="cf-turnstile"
      data-sitekey={siteKey}
      data-theme="dark"
      data-appearance="interaction-only"
    >
    </div>
  </div>

  <p id="form-status" class="hidden" role="status" aria-live="polite"></p>

  <button
    id="submit-button"
    type="submit"
    class="btn bg-primary text-primary-content w-full border-none px-6 text-base hover:bg-white sm:w-auto"
  >
    Send message
  </button>
</form>

<script
  is:inline
  async
  defer
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const button = document.getElementById(
    "submit-button",
  ) as HTMLButtonElement | null;
  const status = document.getElementById("form-status");

  function show(message: string, tone: "success" | "error" | "info") {
    if (!status) return;
    status.textContent = message;
    status.className = [
      "mb-4 rounded p-3 text-center",
      tone === "success" && "bg-success text-success-content",
      tone === "error" && "bg-error text-error-content",
      tone === "info" && "opacity-80",
    ]
      .filter(Boolean)
      .join(" ");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!button) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();
    const token = String(data.get("cf-turnstile-response") ?? "");

    if (!name || !email || !message) {
      show("Please complete all fields before submitting.", "error");
      return;
    }

    if (!token) {
      show(
        "Please complete the verification challenge and try again.",
        "error",
      );
      return;
    }

    button.disabled = true;
    button.setAttribute("aria-busy", "true");
    show("Sending…", "info");

    try {
      const response = await fetch("/api/mail", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          email,
          message,
          turnstileToken: token,
        }),
      });

      const body = await response.json().catch(() => ({}));

      if (response.ok) {
        show("Thanks! Your message has been sent.", "success");
        form.reset();
        button.removeAttribute("aria-busy");
        // Leave the button disabled so a success cannot be double-submitted.
      } else {
        show(
          body.error ?? "Your message could not be sent. Please try again.",
          "error",
        );
        button.disabled = false;
        button.removeAttribute("aria-busy");
        window.turnstile?.reset();
      }
    } catch {
      show(
        "Network error. Please check your connection and try again.",
        "error",
      );
      button.disabled = false;
      button.removeAttribute("aria-busy");
      window.turnstile?.reset();
    }
  });
</script>
