---
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Home", icon: "house" as const },
  { href: "/bio", label: "Bio", icon: "rocket" as const },
  { href: "/recordings", label: "Recordings", icon: "music" as const },
  { href: "/teaching", label: "Teaching", icon: "mortarboard" as const },
  { href: "/lessons", label: "Lessons", icon: "mortarboard" as const },
  { href: "/contact", label: "Contact", icon: "envelope" as const },
];

const isCurrent = (href: string) => path === href;
---

<nav class="border-base-200 sticky top-0 z-20 w-full border-b md:relative">
  <div class="navbar bg-base-100">
    <div class="flex-1 px-6">
      <div class="flex items-center md:hidden">
        <button
          id="nav-toggle"
          type="button"
          class="btn btn-ghost btn-sm"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open navigation menu"
        >
          <Icon name="menu" class="h-6 w-6" />
        </button>
      </div>

      <a
        href="/"
        class="btn btn-ghost gap-2 px-2"
        aria-label="Robert Collins, home"
      >
        <Icon name="trumpet" class="text-xl" />
        <span class="text-primary text-2xl font-bold normal-case"
          >Robert Collins</span
        >
      </a>
    </div>

    <div class="hidden flex-none md:flex">
      <ul class="menu menu-horizontal px-1">
        <li>
          <a
            href="/bio"
            class="hover:text-primary font-thin"
            aria-current={isCurrent("/bio") ? "page" : undefined}
          >
            Bio
          </a>
        </li>
        <li>
          <a
            href="/recordings"
            class="hover:text-primary font-thin"
            aria-current={isCurrent("/recordings") ? "page" : undefined}
          >
            Recordings
          </a>
        </li>
        <li>
          <a
            href="/teaching"
            class="hover:text-primary font-thin"
            aria-current={isCurrent("/teaching") ? "page" : undefined}
          >
            Teaching
          </a>
        </li>
        <li>
          <a
            href="/lessons"
            class="hover:text-primary font-thin"
            aria-current={isCurrent("/lessons") ? "page" : undefined}
          >
            Lessons
          </a>
        </li>
        <li>
          <a
            href="/contact"
            class="hover:text-primary font-thin"
            aria-current={isCurrent("/contact") ? "page" : undefined}
          >
            Contact
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden" hidden>
    <div
      class="fixed inset-0 top-16 flex flex-col items-center justify-evenly bg-black/95 py-4"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="btn-ghost hover:text-primary block py-1 text-center text-lg font-thin"
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            <Icon name={link.icon} class="mx-auto h-8 w-8" />
            <span>{link.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu",
      );
      menu.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
