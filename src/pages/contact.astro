---
import Layout from "../layouts/Layout.astro";
import Picture from "../components/Picture.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="Contact"
  description="Get in touch with trumpet player and teacher Robert Collins about performance opportunities and private lessons."
>
  <section
    class="mx-auto grid max-w-screen-lg gap-8 px-4 py-8 sm:px-8 md:grid-cols-[2fr_3fr] md:gap-12 md:py-14"
  >
    <div class="relative aspect-[16/9] md:aspect-auto">
      <Picture
        src="https://res.cloudinary.com/dwbwyzsyp/image/upload/v1687393780/Robbie/contact_ryqj3w.jpg"
        alt="Robert Collins playing trumpet on stage in front of a brass ensemble"
        blur="/blur/contactBlur.jpg"
        width={400}
        height={600}
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 768px) 380px, 100vw"
        class="absolute inset-0 h-full w-full rounded object-cover object-[center_55%]"
      />
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-3">
        <h1
          class="text-primary text-[clamp(3.5rem,9vw,6rem)] leading-[0.9] tracking-tight"
        >
          Contact
        </h1>
        <p class="text-lg leading-8">
          For performances, collaborations, or anything else. Looking for
          lessons? Use the <a
            href="/lessons"
            class="text-primary underline underline-offset-4 hover:text-white"
            >lesson request form</a
          >.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</Layout>
