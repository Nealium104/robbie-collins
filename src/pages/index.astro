---
import Layout from "../layouts/Layout.astro";
import Picture from "../components/Picture.astro";
import { getHomePageHeader, getHomeParagraphs } from "../lib/content";

// Runs at build time.
const [header, paragraphs] = await Promise.all([
  getHomePageHeader(),
  getHomeParagraphs(),
]);

// "Name, Role" shows the name large and the role as a smaller line beneath.
const [name, ...rest] = (header || "Hi, I'm Robbie").split(",");
const role = rest.join(",").trim();

const heroImage =
  "https://res.cloudinary.com/dwbwyzsyp/image/upload/v1687393746/Robbie/withBackgroundColorCorrected_f6yufy.jpg";
---

<Layout
  title="Home"
  description="Robert Collins is a trumpet player and teacher working across orchestral, chamber, and early music performance."
>
  <section
    class="relative isolate flex min-h-[calc(100vh-4rem)] items-end justify-center pb-[14vh]"
  >
    <Picture
      src={heroImage}
      alt="Robert Collins playing trumpet"
      blur="/blur/withBackgroundColorCorrectedBlur.jpg"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-top"
    />

    <div class="flex flex-col items-center gap-8 px-4">
      <h1
        class="hero-rise flex flex-col items-center gap-3 text-center [text-shadow:0_2px_24px_rgb(0_0_0/0.6)]"
      >
        <span class="text-primary text-5xl leading-none sm:text-7xl lg:text-8xl"
          >{name.trim()}</span
        >
        {role && <span class="sr-only">, </span>}
        {
          role && (
            <span class="text-2xl leading-tight sm:text-3xl lg:text-4xl">
              {role}
            </span>
          )
        }
      </h1>
      <a
        href="/bio"
        class="fade-in-delayed btn bg-primary text-primary-content border-none px-6 text-base hover:bg-white"
      >
        About me
      </a>
    </div>
  </section>

  <section
    class="mx-auto flex max-w-2xl flex-col items-center gap-8 px-4 py-16 text-center sm:py-20"
  >
    {
      paragraphs.map((paragraph) => (
        <p class="text-lg leading-8 sm:text-xl sm:leading-9">
          {paragraph.text}
        </p>
      ))
    }
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/lessons"
        class="btn bg-primary text-primary-content border-none px-6 text-base hover:bg-white"
      >
        Request a lesson
      </a>
      <a
        href="/bio"
        class="btn border-primary text-primary hover:bg-primary hover:text-primary-content bg-transparent px-6 text-base"
      >
        Read my bio
      </a>
    </div>
  </section>
</Layout>
