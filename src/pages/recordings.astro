---
import Layout from "../layouts/Layout.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import { getRecordings } from "../lib/content";

const recordings = await getRecordings();
const [featured, ...rest] = recordings;
---

<Layout
  title="Recordings"
  description="Recorded performances by trumpet player Robert Collins, spanning orchestral, chamber, and early music repertoire."
>
  <div
    class="mx-auto flex max-w-screen-lg flex-col gap-12 px-4 py-10 sm:px-8 sm:py-14"
  >
    <h1
      class="text-primary text-[clamp(3.5rem,9vw,6rem)] leading-[0.9] tracking-tight"
    >
      Recordings
    </h1>

    {
      featured && (
        <article class="flex flex-col gap-4">
          <VideoEmbed
            videoId={featured.videoId}
            title={featured.description || "Robert Collins performance"}
            eager
          />
          {featured.description && (
            <p class="text-xl leading-8">{featured.description}</p>
          )}
        </article>
      )
    }

    {
      rest.length > 0 && (
        <section
          class="grid gap-x-6 gap-y-10 md:grid-cols-2"
          aria-label="More recordings"
        >
          {rest.map((recording) => (
            <article class="flex flex-col gap-3">
              <VideoEmbed
                videoId={recording.videoId}
                title={recording.description || "Robert Collins performance"}
              />
              {recording.description && (
                <p class="leading-7">{recording.description}</p>
              )}
            </article>
          ))}
        </section>
      )
    }

    {
      recordings.length === 0 && (
        <p class="text-lg opacity-70">No recordings published yet.</p>
      )
    }
  </div>
</Layout>
